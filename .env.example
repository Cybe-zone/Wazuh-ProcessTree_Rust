# Server Configuration
HOST=127.0.0.1
PORT=5443

# Database Configuration
DATABASE_URL=sqlite://wptv.db?mode=rwc

# Security
# Secret key must be at least 64 bytes - CHANGE THIS IN PRODUCTION!
SECRET_KEY=your-secret-key-change-this-in-production-must-be-at-least-64-bytes-long-for-security

# Logging
LOG_LEVEL=info

# Performance
MAX_CONNECTIONS=100
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_DURATION=60
CACHE_TTL=300
